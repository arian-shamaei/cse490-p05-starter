{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/gate.py --session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__blender__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/gate.py" }
        ]
      }
    ]
  }
}
