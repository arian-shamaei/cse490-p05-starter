{
  "env": {
    "ANTHROPIC_BASE_URL": "https://litellm-test.cs.washington.edu",
    "ANTHROPIC_MODEL": "claude-sonnet-5"
  },
  "apiKeyHelper": "/bin/sh -c 'echo \"$LITELLM_API_KEY\"'",
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/gate.py --session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__blender__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/gate.py"
          }
        ]
      }
    ]
  }
}
